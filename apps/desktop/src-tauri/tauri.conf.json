{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orchestr",
  "version": "0.1.0",
  "identifier": "app.orchestr.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --workspace @orchestr/desktop",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build --workspace @orchestr/desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Orchestr",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["../../../icon.ico"],
    "targets": "all"
  }
}
